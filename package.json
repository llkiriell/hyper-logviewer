{
  "name": "hyper-logviewer",
  "productName": "Hyper LogViewer",
  "private": true,
  "version": "0.1.0-beta.2",
  "description": "High-performance, local-first log file viewer.",
  "author": "Antonny k. <akecsc@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/llkiriell/hyper-logviewer.git"
  },
  "homepage": "https://github.com/llkiriell/hyper-logviewer#readme",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --mode desktop",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit && vite build && vite build --config vite.electron.config.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tabler/icons-react": "^3.31.0",
    "@tanstack/react-virtual": "^3.13.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "app.hyperlogviewer.desktop",
    "productName": "Hyper LogViewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "log",
        "name": "Log File",
        "description": "Log file readable with Hyper LogViewer",
        "role": "Viewer",
        "icon": "public/file-log-icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hyper LogViewer",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
